  text: "\u0427\u0442\u043E \u0437\u0430 \u0437\u0432\u0443\u043A\u0438? \u041A\u0442\u043E
    \u0442\u044B?! \u0417\u0410 \u0427\u0415\u041C \u0422\u042B \u0421\u042E\u0414\u0410
    \u041F\u0420\u0418\u0428\u0401\u041B???"
  answers:
  - "\u042F \u043F\u0440\u0438\u0448\u0451\u043B \u0442\u0435\u0431\u044F \u0443\u0441\u043C\u0438\u0440\u0438\u0442\u044C!!
    \u0439\u043E\u0443"
  - "\u042F \u0442\u0432\u043E\u0439 \u043F\u043E\u0434\u043F\u0438\u0441\u0447\u0438\u043A
    \u0438 \u044F \u043F\u0440\u0438\u0448\u0451\u043B \u043F\u043E\u043D\u044F\u0442\u044C
    \u0447\u0442\u043E \u0442\u0443\u0442 \u0441\u043B\u0443\u0447\u0438\u043B\u043E\u0441\u044C"
